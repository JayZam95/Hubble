rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // USERS COLLECTION & SUBCOLLECTIONS
    match /users/{userId} {
      allow read: if true; // Allow reading user display profiles
      allow write: if isAuthenticated();

      match /{subcollection=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // LISTINGS (Marketplace catalog & base64 photos)
    match /listings/{listingId} {
      allow read: if true; // Allow browsing listings even before auth
      allow write: if isAuthenticated();
    }

    // CATEGORIES & METADATA
    match /metadata/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /categories/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // BOOKINGS & ORDERS
    match /bookings/{bookingId} {
      allow read, write: if isAuthenticated();
    }

    match /orders/{orderId} {
      allow read, write: if isAuthenticated();
    }

    // DISPUTES & REVIEWS
    match /disputes/{disputeId} {
      allow read, write: if isAuthenticated();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // CART
    match /cart/{cartId} {
      allow read, write: if isAuthenticated();
    }

    // BUS TRIPS & BOOKINGS
    match /bus_trips/{tripId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /bus_bookings/{bookingId} {
      allow read, write: if isAuthenticated();
    }

    // RIDE REQUESTS
    match /ride_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    // CHATS & CONVERSATIONS
    match /conversations/{roomId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /chats/{chatId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // NOTIFICATIONS
    match /notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }

    // KYC VERIFICATIONS
    match /kyc_verifications/{kycId} {
      allow read, write: if isAuthenticated();
    }

    // REWARDS & LOYALTY
    match /rewards/{rewardId} {
      allow read, write: if isAuthenticated();
    }

    // FALLBACK RULE FOR ALL OTHER APP COLLECTIONS
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}

